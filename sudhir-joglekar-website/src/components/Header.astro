---
import { nav, site } from "../data/site.js";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="site-header" data-header>
  <div class="wrap header-inner">
    <a class="brand" href="/">
      <img class="brand-mark" src="/assets/brand-mark.svg" width="42" height="42" alt="" />
      <span class="brand-text">
        <strong>{site.name}</strong>
        <span>{site.brand.en}</span>
      </span>
    </a>
    <button
      class="nav-toggle"
      type="button"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Menu"
    >
      <span></span>
    </button>
    <nav class="nav" id="site-nav" data-nav aria-label="Primary">
      <ul class="nav-list">
        {
          nav.map((item) => {
            const current = item.href === "/" ? path === "/" : path === item.href;
            return (
              <li>
                <a href={item.href} aria-current={current ? "page" : undefined}>
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>
