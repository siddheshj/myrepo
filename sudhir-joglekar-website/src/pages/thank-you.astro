---
import Base from "../layouts/Base.astro";
import { site } from "../data/site.js";
---

<Base title={`Thank you — ${site.fullName}`} description="Enquiry received.">
  <div class="wrap page-hero" style="min-height:50vh;">
    <p class="kicker">Akshay Telemedia</p>
    <h1>Received.</h1>
    <p>
      If this page opened after a Netlify form submission, the enquiry is in the site inbox. You can also write
      directly to <a href={`mailto:${site.email}`}>{site.email}</a>.
    </p>
    <div class="btn-row">
      <a class="btn btn-solid" href="/">Back to home</a>
    </div>
  </div>
</Base>
