---
import Base from "../layouts/Base.astro";
import { site, writingCredits, writingTbd } from "../data/site.js";
---

<Base
  title={`Writing — ${site.fullName}`}
  description="Books and screen writing by Sudhir Vinayak Joglekar, including Jab I Met… and The Blue Revolution / Nil Kranti."
>
  <div class="wrap page-hero">
    <p class="kicker">On the page</p>
    <h1>Writing</h1>
    <p>
      Stories, serials, plays, and screen work. The featured book is <em>Jab I Met…</em>. Untitled series stay
      marked until client files arrive.
    </p>
  </div>

  <div class="wrap section" style="padding-top:0.4rem;">
    <div class="grid-2">
      {
        writingCredits.map((item) =>
          item.status === "featured" ? (
            <article class="card reveal">
              <div class="poster book">
                <img src={item.image} alt={item.imageAlt} />
              </div>
              <p class="meta" style="margin-top:1rem;">
                {item.kind} · {item.year}
              </p>
              <h2>{item.title}</h2>
              <p>{item.body}</p>
              {item.isbn && <p class="caption">ISBN {item.isbn}</p>}
            </article>
          ) : item.status === "tbd-cover" ? (
            <article class="tbd reveal">
              <span class="badge">Cover to come</span>
              <p class="meta">{item.kind}</p>
              <h2>{item.title}</h2>
              {item.titleMr && <p class="mr">{item.titleMr}</p>}
              <p>{item.body}</p>
            </article>
          ) : (
            <article class="card reveal">
              <p class="meta">{item.kind}</p>
              <h2>{item.title}</h2>
              {item.titleMr && <p class="mr">{item.titleMr}</p>}
              <p>{item.body}</p>
              {item.href && (
                <p>
                  <a href={item.href}>Producing page</a>
                </p>
              )}
            </article>
          )
        )
      }
    </div>
  </div>

  <div class="wrap section" style="padding-top:0;">
    <div class="section-head">
      <div>
        <p class="kicker">Still gathering titles</p>
        <h2>Serials & plays</h2>
      </div>
    </div>
    <div class="grid-2">
      {
        writingTbd.map((item) => (
          <article class="tbd reveal">
            <span class="badge">Titles TBD</span>
            <h3>{item.title}</h3>
            <p>{item.detail}</p>
          </article>
        ))
      }
    </div>
  </div>
</Base>
